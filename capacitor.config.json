{
  "appId": "com.capisoft.logo",
  "appName": "logo",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "cleartext": true,
    "proxy": {
      "/api": {
        "target": "http://10.0.2.2:8000",
        "changeOrigin": true,
        "pathRewrite": {
          "^/api": ""
        }
      }
    }
  },

  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "backgroundColor": "#6f6cf3",
      "showSpinner": false,
      "androidSpinnerStyle": "small",
      "iosSpinnerStyle": "small",
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
